{
  "openapi": "3.0.3",
  "info": {
    "title": "Navalnyarchive API",
    "description": "This API provides access to the content from navalny.com, including blogs, social media, projects, and photographs associated with Alexei Navalny. It allows developers to programmatically interact with the stored content. Response schema rewritten 2026-11-03 from a live probe: /ru/daily-posts/today/ answers one object {date, editorial, material}, not the {count, date, posts} list the earlier schema declared. Item shapes of tags, people, places and related_materials are unverified (empty when probed).",
    "version": "1.0.0",
    "contact": {
      "url": "https://github.com/l0v3m0n3y/Navalnyarchive"
    }
  },
  "servers": [
    {
      "url": "https://api-archive.navalny.com/api/v1",
      "description": "Production server"
    }
  ],
  "paths": {
    "/ru/daily-posts/today/": {
      "get": {
        "summary": "Get daily posts today",
        "description": "Retrieves the daily posts for today from the Navalny archive",
        "operationId": "getDailyPostsToday",
        "tags": [
          "Daily Posts"
        ],
        "responses": {
          "200": {
            "description": "Successful response with daily posts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The archive entry for today's date: one editorial and the material it reproduces.",
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date",
                      "example": "2026-11-03"
                    },
                    "editorial": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "slug": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "preview_image": {
                          "type": "string",
                          "nullable": true
                        },
                        "description": {
                          "type": "string",
                          "nullable": true
                        },
                        "quote": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "sections": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string"
                              },
                              "text": {
                                "type": "string"
                              },
                              "url": {
                                "type": "string"
                              },
                              "author": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              },
                              "material_id": {
                                "type": "integer"
                              },
                              "entities": {
                                "type": "array",
                                "items": {}
                              }
                            }
                          }
                        },
                        "tags": {
                          "type": "array",
                          "items": {}
                        },
                        "people": {
                          "type": "array",
                          "items": {}
                        },
                        "places": {
                          "type": "array",
                          "items": {}
                        },
                        "related_materials": {
                          "type": "array",
                          "items": {}
                        }
                      }
                    },
                    "material": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "example": "twitter_day"
                        },
                        "date_published": {
                          "type": "string",
                          "format": "date"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No posts found for today",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the post"
          },
          "title": {
            "type": "string",
            "description": "Title of the post"
          },
          "content": {
            "type": "string",
            "description": "Content of the post"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Publication date of the post"
          },
          "author": {
            "type": "string",
            "description": "Author of the post"
          },
          "source": {
            "type": "string",
            "description": "Source platform (blog, social media, etc.)"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Original URL of the post"
          }
        }
      },
      "DailyPostsResponse": {
        "type": "object",
        "properties": {
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "count": {
            "type": "integer",
            "description": "Total number of posts returned"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date for which posts are retrieved"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Daily Posts",
      "description": "Operations related to daily posts from the Navalny archive"
    }
  ]
}
