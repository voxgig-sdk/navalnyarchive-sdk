# Entity: daily_post

main: kit: entity: daily_post: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      type: "`$STRING`"
    }
    {
      name: "content"
      req: false
      type: "`$STRING`"
    }
    {
      name: "date"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "source"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "daily_post"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/ru/daily-posts/today/"
          parts: [
            "ru"
            "daily-posts"
            "today"
          ]
          select: {
            "$action": "today"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.posts`"
          }
        }
      ]
    }
  }



}
