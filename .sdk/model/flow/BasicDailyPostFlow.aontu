  entity: "daily_post",
  kind: "basic",
  name: "BasicDailyPostFlow",
  step: [
    {
      i: {
        ref: "daily_post_ref01",
        srcdatavar: "daily_post_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-daily_post_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDailyPostFlow"
}